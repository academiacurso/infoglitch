{
  "name": "@infoglitch/mcp",
  "version": "0.1.0",
  "description": "Servidor MCP de infoglitch: generá y renderizá infografías de programación desde cualquier cliente MCP (Claude Desktop, IDEs, etc.).",
  "license": "MIT",
  "author": "Duglas Moreno",
  "repository": { "type": "git", "url": "git+https://github.com/academiacurso/infoglitch.git", "directory": "packages/mcp" },
  "homepage": "https://github.com/academiacurso/infoglitch/tree/master/packages/mcp#readme",
  "bugs": "https://github.com/academiacurso/infoglitch/issues",
  "type": "module",
  "bin": { "infoglitch-mcp": "./dist/server.js" },
  "files": ["dist"],
  "keywords": ["infographic", "mcp", "model-context-protocol", "svg", "ai", "infoglitch"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@infoglitch/ai": "workspace:*",
    "@infoglitch/core": "workspace:*",
    "@infoglitch/export": "workspace:*",
    "@infoglitch/fonts": "workspace:*",
    "@infoglitch/icons": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.0.5"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
