{
  "name": "@infoglitch/vue",
  "version": "0.1.1",
  "description": "Componente Vue 3 para renderizar infografías de infoglitch",
  "license": "MIT",
  "author": "Duglas Moreno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academiacurso/infoglitch.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/academiacurso/infoglitch/tree/master/packages/vue#readme",
  "bugs": "https://github.com/academiacurso/infoglitch/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "infographic",
    "vue",
    "svg",
    "infoglitch"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@infoglitch/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
