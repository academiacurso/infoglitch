{
  "name": "@infoglitch/export",
  "version": "0.2.0",
  "description": "Exporta infografías de infoglitch (SVG) a PNG y PDF en el navegador, sin dependencias.",
  "license": "MIT",
  "author": "Duglas Moreno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academiacurso/infoglitch.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/academiacurso/infoglitch/tree/master/packages/export#readme",
  "bugs": "https://github.com/academiacurso/infoglitch/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "infographic",
    "svg",
    "png",
    "pdf",
    "export",
    "resvg",
    "infoglitch"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
