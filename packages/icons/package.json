{
  "name": "@infoglitch/icons",
  "version": "0.1.1",
  "description": "Logos de lenguajes y herramientas (Simple Icons, CC0) como fuente de iconos para infoglitch.",
  "license": "MIT",
  "author": "Duglas Moreno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academiacurso/infoglitch.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/academiacurso/infoglitch/tree/master/packages/icons#readme",
  "bugs": "https://github.com/academiacurso/infoglitch/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "infographic",
    "icons",
    "simple-icons",
    "logos",
    "infoglitch"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@infoglitch/core": "workspace:*",
    "simple-icons": "^16.37.0"
  },
  "devDependencies": {
    "devicon": "^2.18.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
