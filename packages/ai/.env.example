# Claves de API (se usan SOLO en servidor/Node, nunca en el browser).
# Configurá sólo la del proveedor que vayas a usar.

# Anthropic (proveedor por defecto)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI / ChatGPT
OPENAI_API_KEY=sk-...

# OpenRouter (compatible OpenAI)
OPENROUTER_API_KEY=sk-or-...

# Google Gemini (endpoint compatible OpenAI)
GEMINI_API_KEY=...
# (alternativa aceptada: GOOGLE_API_KEY)

# Opcionales
# INFOGLITCH_PROVIDER=anthropic   # anthropic | openai | openrouter | gemini
# INFOGLITCH_MODEL=claude-opus-5-5
