{
  "name": "@infoglitch/svelte",
  "version": "0.1.0",
  "description": "Componente Svelte para renderizar infografías de infoglitch",
  "license": "MIT",
  "author": "Duglas Moreno",
  "repository": { "type": "git", "url": "git+https://github.com/academiacurso/infoglitch.git", "directory": "packages/svelte" },
  "homepage": "https://github.com/academiacurso/infoglitch/tree/master/packages/svelte#readme",
  "bugs": "https://github.com/academiacurso/infoglitch/issues",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
