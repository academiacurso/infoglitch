{
  "name": "@infoglitch/core",
  "version": "0.1.0",
  "description": "Núcleo de infoglitch: modelo de documento, DSL tolerante, renderer SVG, temas e iconos para infografías de programación",
  "license": "MIT",
  "author": "Duglas Moreno",
  "repository": { "type": "git", "url": "git+https://github.com/academiacurso/infoglitch.git", "directory": "packages/core" },
  "homepage": "https://github.com/academiacurso/infoglitch/tree/master/packages/core#readme",
  "bugs": "https://github.com/academiacurso/infoglitch/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "keywords": ["infographic", "svg", "visualization", "ai", "programming", "infoglitch"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
