# Server-side. Copiá este archivo a .env.local y configurá la clave del proveedor.
# Proveedor: anthropic (default) | openai | openrouter | gemini
# INFOGLITCH_PROVIDER=anthropic

# Según el proveedor elegido:
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# GEMINI_API_KEY=...

# Opcional: modelo (default según proveedor)
# INFOGLITCH_MODEL=claude-opus-5-5

# Opcional: ampliar la whitelist de modelos permitidos por el servidor
# (lista separada por comas; se suma a la lista base por proveedor)
# INFOGLITCH_ALLOWED_MODELS=gpt-4.1,anthropic/claude-3.7-sonnet
